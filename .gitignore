    .vscode/
    .idea/
    *.iml
    *.ipr
    *.iws

    # Testing
    .pytest_cache/
    .coverage
    htmlcov/

    # Logs and databases
    *.log
    *.sqlite3
    *.db

    # OS generated files
    .DS_Store
    Thumbs.db